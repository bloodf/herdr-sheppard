{
  "name": "@bloodf/omp-herdr-sheppard",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "omp": {
    "extensions": [
      "dist/reporter.js"
    ]
  },
  "license": "MIT",
  "description": "Herdr orchestrator and worker manager with a popup and localhost dashboard",
  "scripts": {
    "build": "bun build reporter.ts --target=bun --outdir=dist",
    "test:controller": "python3 -m unittest test_crew.py",
    "test:dashboard": "node test_dashboard.cjs && node test_auth.cjs",
    "check": "tsc --noEmit",
    "test:reporter": "bun test test_reporter.test.ts"
  },
  "dependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "18.8.9",
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.0"
  },
  "files": [
    "crew.py",
    "dashboard.html",
    "dist/reporter.js",
    "README.md",
    "LICENSE",
    "NOTICE",
    "ZOD-LICENSE"
  ]
}
